{
  "name": "screenforge",
  "version": "2.3.0",
  "license": "MIT",
  "description": "ScreenForge - Digital Signage Management Server",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "build:legacy-player": "node scripts/build-legacy-player.js",
    "build:certified-hardware": "node scripts/build-certified-hardware.js",
    "test": "node --test --test-concurrency=2",
    "smoke": "node smoke-ui.js",
    "lint": "eslint lib/ai-agent.js lib/ai-tools.js lib/sentry.js lib/secretbox.js test/ai-agent.test.js eslint.config.mjs",
    "format:check": "prettier --check lib/ai-agent.js lib/ai-tools.js lib/sentry.js test/ai-agent.test.js ../frontend/js/components/ai-chat.js ../frontend/js/views/brain.js ../frontend/js/views/overview.js",
    "format:write": "prettier --write lib/ai-agent.js lib/ai-tools.js lib/sentry.js test/ai-agent.test.js ../frontend/js/components/ai-chat.js ../frontend/js/views/brain.js ../frontend/js/views/overview.js"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.1",
    "@jsquash/avif": "^1.3.0",
    "@jsquash/webp": "^1.5.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-ical": "^0.26.1",
    "nodemailer": "^9.0.5",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3",
    "stripe": "^20.4.1",
    "unzipper": "^0.12.3",
    "uuid": "^14.0.0",
    "@sentry/node": "^9.44.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "12.9.0",
    "puppeteer-core": "^24.43.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "js-yaml": "^4.2.0",
    "sharp": "^0.35.3",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "prettier": "^3.7.4"
  }
}
